# Apollo.io API key (Settings -> Integrations -> API in Apollo).
# Required for /api/search-contacts and /api/mcp to work. Set this in
# Vercel under Project Settings -> Environment Variables, and locally in
# .env.local (which is gitignored).
APOLLO_API_KEY=

# Shared secret for the hosted MCP endpoint (/api/mcp), used as a custom
# connector in claude.ai so any salesperson can query Apollo contacts
# without a Claude Code session or repo access. Generate a random value
# (e.g. `openssl rand -hex 32`), set it here and in Vercel, and enter the
# same value as the Bearer token when adding the connector in claude.ai.
# Requests without a matching Authorization: Bearer <token> header are
# rejected -- this endpoint fails closed if the variable is unset.
MCP_ACCESS_TOKEN=
